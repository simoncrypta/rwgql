# Local Postgres is provisioned by vp run local-testing-api#prepare.
# Production API (environment variables, or api/.env):
# DATABASE_URL=postgresql://...
# DB_AUTH_SECRET=replace-with-a-strong-secret
# WEB_ORIGIN=https://web.example.com
# DB_AUTH_COOKIE_DOMAIN=.example.com
# DB_AUTH_COOKIE_SAMESITE=None
# Web build (set in the shell or web/.env.production.local):
# VITE_API_URL=https://api.example.com
# Web runtime (optional internal URL for server-side auth):
# API_URL=https://api.example.com
