{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "paths": {
      "src/*": ["./src/*"],
      "types/*": ["./types/*"]
    },
    "rootDirs": [".", "./.react-router/types"]
  },
  "include": [
    "src",
    "types",
    "scripts",
    "db/seed.ts",
    "*.ts",
    ".rwgql",
    ".react-router/types",
    "testUtils"
  ]
}
