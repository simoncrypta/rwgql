{
  "include": ["src", "workers", "testUtils", "types", ".rwgql", ".react-router/types/**/*"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["@cloudflare/workers-types", "vite/client", "./types/vitest.d.ts"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "@/*": ["./src/*"],
      "@app/types/*": ["./types/*"]
    },
    "plugins": [
      {
        "name": "@0no-co/graphqlsp",
        "schema": "../../graphql/schema.graphql"
      }
    ],
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  }
}
