  "routes/post.tsx": "// Generated from src/Routes.tsx by @rwgql/router. Do not edit.

import { data, type LoaderFunctionArgs, useParams } from "react-router";
import { parseRouteParams } from "@rwgql/router";
import Page from "../../src/pages/PostPage/PostPage";
import { loader as pageLoader } from "../../src/pages/PostPage/PostPage";

const paramTypes = {"id":"Int"} as const;

// A param that does not match its Cedar type is a 404.
export const loader = (args: LoaderFunctionArgs) => {
  if (!parseRouteParams(paramTypes, args.params)) {
    throw data(null, { status: 404 });
  }

  return pageLoader(args as Parameters<typeof pageLoader>[0]);
};

export { headers } from "../../src/pages/PostPage/PostPage";

export default function PostRoute() {
  const params = parseRouteParams(paramTypes, useParams());
  if (!params) {
    // Unreachable after the loader's 404; keeps the page props typed.
    throw new Error("@rwgql/router: params do not match post");
  }

  return <Page {...params} />;
}
